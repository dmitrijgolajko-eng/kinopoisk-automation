# Базовые URL для работы с API и веб-интерфейсом
BASE_URL=https://www.kinopoisk.ru
API_URL=https://api.kinopoisk.dev

# Учетные данные для авторизации в системе
KP_LOGIN=ваш_логин
KP_PASSWORD=ваш_пароль

# API ключ для работы с API Кинопоиска
API_KEY=ваш_api_ключ

# Настройки таймаутов для Selenium
IMPLICIT_WAIT=10
EXPLICIT_WAIT=20

# Настройки окружения (development/production)
ENVIRONMENT=development

# Настройки логирования (опционально)
LOG_LEVEL=INFO

# Настройки Allure для отчетов
ALLURE_REPORT_DIR=allure-report
