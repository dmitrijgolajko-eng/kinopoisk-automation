# Файл конфигурации окружения
# Скопируйте этот файл в .env и заполните значения

# API ключи и настройки
API_URL=https://api.kinopoisk.ru
API_KEY=your_api_key_here

# Настройки базы данных (если используется)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=test_db
DB_USER=test_user
DB_PASSWORD=test_password

# Настройки тестовой среды
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=testpass123

# Настройки Allure
ALLURE_RESULTS_DIR=allure-results
ALLURE_REPORT_DIR=allure-report

# Настройки CI/CD (опционально)
CI=false  # Установить в true при работе в CI
HEADLESS=true  # Режим headless для тестов
